# Maalim environment variables — copy to .env and fill in real values
# NEVER commit the real .env file.

# --- Core ---
# JWT signing secret. Generate a strong one: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-long-random-string
# development | production
ENVIRONMENT=development
# JWT lifetime in minutes (1440 = 24h)
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# --- Database ---
# Local dev (SQLite):
DATABASE_URL=sqlite:///./maalim.db
# Production (PostgreSQL via docker-compose or managed Neon/Supabase):
# DATABASE_URL=postgresql://maalim:maalim@localhost:5432/maalim

# --- CORS ---
# Comma-separated allow-list; use * only in development
CORS_ORIGINS=*

# --- Rate limiting (auth endpoints) ---
RATE_LIMIT_LOGIN=10/minute
RATE_LIMIT_REGISTER=5/minute
